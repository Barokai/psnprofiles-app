{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", "schedule:monthly"],
  "timezone": "Europe/Vienna",
  "labels": ["dependencies"],
  "prConcurrentLimit": 3,
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "description": "One PR for all routine library updates",
      "groupName": "all non-major dependencies",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"]
    },
    {
      "description": "Majors are only listed in the Dependency Dashboard until ticked there",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Ktor modules must stay in sync",
      "groupName": "Ktor",
      "matchPackageNames": ["io.ktor{/,}**"]
    },
    {
      "description": "Voyager modules must stay in sync",
      "groupName": "Voyager",
      "matchPackageNames": ["cafe.adriel.voyager{/,}**"]
    },
    {
      "description": "GitHub Actions together",
      "groupName": "GitHub Actions",
      "matchManagers": ["github-actions"]
    },
    {
      "description": "Toolchain and libraries that depend on it: one group, on approval until the upgrade in docs/PLAN.md is done. Remove dependencyDashboardApproval afterwards.",
      "groupName": "Android and Kotlin toolchain",
      "matchPackageNames": [
        "org.jetbrains.kotlin**",
        "org.jetbrains.compose**",
        "com.android**",
        "androidx.**",
        "com.russhwolf:**",
        "gradle"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "ksoup 0.2.x needs Kotlin 2.3+; remove this pin with the toolchain upgrade",
      "matchPackageNames": ["com.fleeksoft.ksoup:ksoup"],
      "allowedVersions": "<0.2.0"
    }
  ]
}
